# Environment: development, staging, production
NODE_ENV=development

# Backend Server
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000

# Frontend
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travel_india_smart
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_12345
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# Firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Third-party APIs
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
OPENAI_API_KEY=

# Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMS/WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@travelindiasmart.com

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log
